# API Gateway Virtual Host Template
# Explain 'Why': Template is processed by NGINX envsubst at container startup to dynamically inject service addresses.

# Map ENABLE_DOCS environment variable (when 'false', '0', or 'off', all documentation endpoints return 404)
map "${ENABLE_DOCS}" $docs_disabled {
    "false" 1;
    "0"     1;
    "off"   1;
    default 0;
}

# Map dynamic CORS origin validation using configured regex
# Explain 'Why': Evaluates incoming client Origin against CORS_ALLOWED_ORIGIN_REGEX to allow credentials safely on configured frontend domains.
map $http_origin $cors_origin {
    default "";
    "~${CORS_ALLOWED_ORIGIN_REGEX}" "$http_origin";
}

server {
    listen ${GATEWAY_PORT} default_server;
    listen [::]:${GATEWAY_PORT} default_server;
    server_name _;

    # Explain 'Why': Include baseline security headers across all responses.
    include /etc/nginx/snippets/security-headers.conf;

    # Explain 'Why': Runtime DNS resolver enables dynamic upstream re-resolution every 5s,
    # preventing stale IP caching when backend containers restart on Docker bridge networks.
    resolver ${DNS_RESOLVER} valid=5s ipv6=off;
    resolver_timeout 3s;

    # Explain 'Why': Assigning upstream URLs to NGINX variables forces NGINX to resolve hostnames
    # dynamically via the configured resolver instead of statically at startup.
    set $auth_backend "${AUTH_SERVICE_URL}";
    set $product_backend "${PRODUCT_SERVICE_URL}";
    set $order_backend "${ORDER_SERVICE_URL}";
    set $user_backend "${USER_SERVICE_URL}";

    # -------------------------------------------------------------------------
    # Internal Auth Subrequest Verification
    # -------------------------------------------------------------------------
    # Explain 'Why': Evaluates JWT tokens/cookies against store_auth for user-protected services (e.g. Orders).
    # Enforces authentication on all non-preflight requests to inject verified X-User-* headers.
    location = /_auth_verify {
        internal;
        if ($request_method = OPTIONS) {
            return 200;
        }

        proxy_pass $auth_backend/api/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Request-ID $req_id;
    }

    # Explain 'Why': Evaluates JWT tokens/cookies for services with public read access (e.g. Products).
    # Allows GET/HEAD/OPTIONS to pass through anonymously, while mutating methods require valid caller claims.
    location = /_auth_verify_mutation_only {
        internal;
        if ($request_method ~ ^(GET|HEAD|OPTIONS)$) {
            return 200;
        }

        proxy_pass $auth_backend/api/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Request-ID $req_id;
    }

    # -------------------------------------------------------------------------
    # Health Check Endpoint
    # -------------------------------------------------------------------------
    # Explain 'Why': Provides container orchestrators and load balancers a direct status probe without hitting downstream services.
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","service":"store_gateway"}\n';
    }

    # -------------------------------------------------------------------------
    # Auth Service Endpoints
    # -------------------------------------------------------------------------
    # Explain 'Why': Routes /api/auth/* and /api/v1/auth/* to store_auth while applying CORS, anti-spoofing, and proxy headers.
    location /api/auth/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $auth_backend$request_uri;
    }

    location = /api/auth {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $auth_backend/api/auth;
    }

    location /api/v1/auth/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/v1/auth/(.*)$ /api/auth/$1 break;
        proxy_pass $auth_backend;
    }

    location = /api/v1/auth {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/auth break;
        proxy_pass $auth_backend;
    }

    # Explain 'Why': Public RS256 JWKS key distribution endpoint consumed by frontend and downstream microservices.
    location = /.well-known/jwks.json {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $auth_backend/.well-known/jwks.json;
    }

    # -------------------------------------------------------------------------
    # Product Service Endpoints
    # -------------------------------------------------------------------------
    # Explain 'Why': Routes /api/products/* and /api/v1/products/* to product_service (v1) while applying CORS, mutation auth offload, and proxy headers.
    location /api/products/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload-mutation.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/products/(.*)$ /api/v1/products/$1 break;
        proxy_pass $product_backend;
    }

    location = /api/products {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload-mutation.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/v1/products break;
        proxy_pass $product_backend;
    }

    location /api/v1/products/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload-mutation.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend$request_uri;
    }

    location = /api/v1/products {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload-mutation.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend/api/v1/products;
    }

    # Explain 'Why': Routes /api/admin/products/* and /api/v1/admin/products/* to product_service while applying CORS, anti-spoofing, auth offload, and proxy headers.
    location /api/admin/products/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/admin/products/(.*)$ /api/v1/admin/products/$1 break;
        proxy_pass $product_backend;
    }

    location = /api/admin/products {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/v1/admin/products break;
        proxy_pass $product_backend;
    }

    location /api/v1/admin/products/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend$request_uri;
    }

    location = /api/v1/admin/products {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend/api/v1/admin/products;
    }

    # Explain 'Why': External payment provider webhooks (e.g. Midtrans) send unauthenticated notifications that must not be blocked by user auth subrequests.
    location /api/orders/webhook/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/orders/webhook/(.*)$ /api/v1/orders/webhook/$1 break;
        proxy_pass $order_backend;
    }

    location /api/v1/orders/webhook/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend$request_uri;
    }

    # Explain 'Why': Routes /api/admin/orders/* and /api/v1/admin/orders/* to order_service while applying CORS, anti-spoofing, auth offload, and proxy headers.
    location /api/admin/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/admin/orders/(.*)$ /api/v1/admin/orders/$1 break;
        proxy_pass $order_backend;
    }

    location = /api/admin/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/v1/admin/orders break;
        proxy_pass $order_backend;
    }

    location /api/v1/admin/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend$request_uri;
    }

    location = /api/v1/admin/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend/api/v1/admin/orders;
    }

    # Explain 'Why': Routes /api/dev/orders/* and /api/v1/dev/orders/* to order_service development testing and simulation endpoints.
    location /api/dev/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/dev/orders/(.*)$ /api/v1/dev/orders/$1 break;
        proxy_pass $order_backend;
    }

    location = /api/dev/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/v1/dev/orders break;
        proxy_pass $order_backend;
    }

    location /api/v1/dev/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend$request_uri;
    }

    location = /api/v1/dev/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend/api/v1/dev/orders;
    }

    # -------------------------------------------------------------------------
    # Order Service Endpoints
    # -------------------------------------------------------------------------
    # Explain 'Why': Routes /api/orders/* and /api/v1/orders/* to order_service (v1) while applying CORS, anti-spoofing, auth offload, and proxy headers.
    location /api/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/orders/(.*)$ /api/v1/orders/$1 break;
        proxy_pass $order_backend;
    }

    location = /api/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/v1/orders break;
        proxy_pass $order_backend;
    }

    location /api/v1/orders/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend$request_uri;
    }

    location = /api/v1/orders {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend/api/v1/orders;
    }

    # -------------------------------------------------------------------------
    # User Service Endpoints
    # -------------------------------------------------------------------------
    # Explain 'Why': Routes /api/users/* and /api/v1/users/* to user_service while applying CORS, anti-spoofing, auth offload, and proxy headers.
    location /api/users/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $user_backend$request_uri;
    }

    location = /api/users {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $user_backend/api/users;
    }

    location /api/v1/users/ {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/api/v1/users/(.*)$ /api/users/$1 break;
        proxy_pass $user_backend;
    }

    location = /api/v1/users {
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/anti-spoofing.conf;
        include /etc/nginx/snippets/auth-offload.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /api/users break;
        proxy_pass $user_backend;
    }

    # -------------------------------------------------------------------------
    # Documentation & OpenAPI Specs Proxy (Conditional on ENABLE_DOCS)
    # -------------------------------------------------------------------------
    # Root documentation index
    location = /docs {
        if ($docs_disabled) {
            return 404;
        }
        default_type text/html;
        return 200 '<!DOCTYPE html><html><head><title>Store API Documentation Hub</title><style>body{font-family:sans-serif;max-width:800px;margin:40px auto;line-height:1.6;padding:0 20px;}h1{color:#1a73e8;}a{color:#1a73e8;text-decoration:none;}a:hover{text-decoration:underline;}ul{list-style-type:none;padding:0;}li{margin:12px 0;padding:12px;border:1px solid #e0e0e0;border-radius:6px;}</style></head><body><h1>Store API Documentation Hub</h1><ul><li><strong>Product Service (Modern Scalar UI):</strong> <a href="/docs/products/scalar/">/docs/products/scalar/</a></li><li><strong>Product Service (Swagger UI):</strong> <a href="/docs/products/swagger/">/docs/products/swagger/</a></li><li><strong>Product Service OpenAPI Specs:</strong> <a href="/docs/products/openapi.json">openapi.json</a> | <a href="/docs/products/openapi.yaml">openapi.yaml</a></li><li><strong>Order Service (Modern Scalar UI):</strong> <a href="/docs/orders/scalar">/docs/orders/scalar</a></li><li><strong>Order Service (Swagger UI):</strong> <a href="/docs/orders/swagger">/docs/orders/swagger</a></li><li><strong>Order Service OpenAPI Specs:</strong> <a href="/docs/orders/openapi.json">openapi.json</a> | <a href="/docs/orders/openapi.yaml">openapi.yaml</a></li><li><strong>User Service (Swagger UI):</strong> <a href="/docs/users/swagger">/docs/users/swagger</a></li><li><strong>User Service OpenAPI Specs:</strong> <a href="/docs/users/openapi.json">openapi.json</a> | <a href="/docs/users/openapi.yaml">openapi.yaml</a></li><li><strong>Auth Service (Swagger UI):</strong> <a href="/docs/auth/">/docs/auth/</a></li><li><strong>Auth Service OpenAPI Spec:</strong> <a href="/docs/auth/openapi.yaml">openapi.yaml</a></li><li><strong>Auth Public JWKS:</strong> <a href="/.well-known/jwks.json">/.well-known/jwks.json</a></li></ul></body></html>\n';
    }

    # Auth Service Documentation
    location = /docs/auth {
        if ($docs_disabled) {
            return 404;
        }
        return 302 /docs/auth/;
    }

    location /docs/auth/ {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/auth/(.*)$ /docs/$1 break;
        proxy_pass $auth_backend;
    }

    location = /docs/auth/openapi.yaml {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $auth_backend/docs/openapi.yaml;
    }

    # Product Service Documentation
    location = /docs/products {
        if ($docs_disabled) {
            return 404;
        }
        return 302 /docs/products/scalar/;
    }

    location /docs/products/scalar {
        if ($docs_disabled) {
            return 404;
        }
        return 302 /docs/products/scalar/;
    }

    location /docs/products/scalar/ {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/products/scalar/(.*)$ /docs/$1 break;
        proxy_pass $product_backend;
    }

    location = /docs/products/swagger {
        if ($docs_disabled) {
            return 404;
        }
        return 302 /docs/products/swagger/;
    }

    location /docs/products/swagger/ {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/products/swagger/(.*)$ /swagger/$1 break;
        proxy_pass $product_backend;
    }

    location = /docs/products/openapi.json {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend/openapi.json;
    }

    location = /docs/products/openapi.yaml {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $product_backend/openapi.yaml;
    }

    # Order Service Documentation
    location = /docs/orders {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /docs break;
        proxy_pass $order_backend;
    }

    location /docs/orders/scalar {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/orders/scalar(.*)$ /docs$1 break;
        proxy_pass $order_backend;
    }

    location /docs/orders/swagger {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/orders/swagger(.*)$ /swagger$1 break;
        proxy_pass $order_backend;
    }

    location = /docs/orders/openapi.json {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend/docs/openapi.json;
    }

    location = /docs/orders/openapi.yaml {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $order_backend/docs/openapi.yaml;
    }

    # User Service Documentation
    location = /docs/users {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^ /docs break;
        proxy_pass $user_backend;
    }

    location /docs/users/swagger {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        rewrite ^/docs/users/swagger(.*)$ /swagger$1 break;
        proxy_pass $user_backend;
    }

    location = /docs/users/openapi.json {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $user_backend/docs/openapi.json;
    }

    location = /docs/users/openapi.yaml {
        if ($docs_disabled) {
            return 404;
        }
        include /etc/nginx/snippets/cors.conf;
        include /etc/nginx/snippets/proxy-params.conf;

        proxy_pass $user_backend/docs/openapi.yaml;
    }
}
