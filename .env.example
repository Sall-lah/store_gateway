# Gateway Configuration
GATEWAY_PORT=80
ENABLE_DOCS=true

# Downstream Microservices (Container network DNS or host URLs)
AUTH_SERVICE_URL=http://auth-service:8080
PRODUCT_SERVICE_URL=http://product-service:8040
ORDER_SERVICE_URL=http://order-service:8060
USER_SERVICE_URL=http://user-service:8082

# Allowed Origins Regex for CORS (supports localhost, custom domain, and subdomains)
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|([a-zA-Z0-9-]+\.)*yourdomain\.com)(:[0-9]+)?$

# Cloudflare Tunnel Token (optional; leave empty for standalone NGINX mode)
CLOUDFLARE_TUNNEL_TOKEN=
