# API Gateway Environment Configuration
# Explain 'Why': Exposes configuration toggles without baking environment-specific hostnames into the Docker image.

# Port on which the NGINX API Gateway will listen
GATEWAY_PORT=80

# Downstream Microservice Host URLs (internal Docker network DNS or host overrides)
# In Docker Compose network:
AUTH_SERVICE_URL=http://auth-service:8080
PRODUCT_SERVICE_URL=http://product-service:8040

# For hybrid local development (services running directly on host OS while gateway is in Docker):
# AUTH_SERVICE_URL=http://host.docker.internal:8080
# PRODUCT_SERVICE_URL=http://host.docker.internal:8040

# Client Allowed Origins for CORS (comma-separated or handled via NGINX map)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
